<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- The "M" reflection monogram: left stroke solid, right stroke thinner/dimmer, so the
         mark itself reads as an echo of its own reflection. Same shape as the boot splash. -->
    <path
        android:pathData="M27,81 L27,27 L54,58.5"
        android:strokeColor="@color/mirror_charcoal"
        android:strokeWidth="5.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
    <path
        android:pathData="M54,58.5 L81,27 L81,81"
        android:strokeColor="@color/mirror_charcoal"
        android:strokeAlpha="0.55"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
</vector>
