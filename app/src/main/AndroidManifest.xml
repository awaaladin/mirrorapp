<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Photo picker (Android 13+) does not require READ_MEDIA_IMAGES; the legacy
         gallery picker on older OS versions is launched via ACTION_OPEN_DOCUMENT / GET_CONTENT
         which also does not require a runtime permission. No storage permission is declared
         because the app never needs broad media library access, only user-selected images. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- Only used for account authentication against the custom mirror-backend server. The
         on-device face detection and makeup rendering pipeline still never makes a network call. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".MirrorApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mirror">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Mirror.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
